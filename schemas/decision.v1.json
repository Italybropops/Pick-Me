{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "ready": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "setup",
              "conditional",
              "excluded"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reasons": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "factors": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "guidance": {
            "type": "string",
            "maxLength": 20000
          },
          "prompt": {
            "type": "string",
            "maxLength": 65000
          },
          "evidenceIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            }
          }
        },
        "required": [
          "providerId",
          "status",
          "score",
          "reasons",
          "factors",
          "guidance",
          "prompt",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "setup": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "setup",
              "conditional",
              "excluded"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reasons": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "factors": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "guidance": {
            "type": "string",
            "maxLength": 20000
          },
          "prompt": {
            "type": "string",
            "maxLength": 65000
          },
          "evidenceIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            }
          }
        },
        "required": [
          "providerId",
          "status",
          "score",
          "reasons",
          "factors",
          "guidance",
          "prompt",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "conditional": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "setup",
              "conditional",
              "excluded"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reasons": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "factors": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "guidance": {
            "type": "string",
            "maxLength": 20000
          },
          "prompt": {
            "type": "string",
            "maxLength": 65000
          },
          "evidenceIds": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
