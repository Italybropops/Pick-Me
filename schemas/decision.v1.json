          "reasons",
          "factors",
          "guidance",
          "prompt",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
