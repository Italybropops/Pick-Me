{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "os": {
      "type": "string",
      "enum": [
        "unknown",
        "macos",
        "linux",
        "windows"
      ]
    },
    "memoryGb": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "provenance": {
      "type": "string",
      "const": "user-reported"
    },
    "checkedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "os",
    "memoryGb",
    "description",
    "provenance",
    "checkedAt"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/Italybropops/Pick-Me/schemas/hardware.v1.json",
  "title": "Pick-Me hardware v1"
}
