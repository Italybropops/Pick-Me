      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "manual",
              "ai"
            ]
          },
          "capabilities": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "writing",
                "organization",
                "coding",
                "research",
                "image",
                "video"
              ]
            }
          },
          "offline": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "commercial": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "zeroCost": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "os": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "any",
                "macos",
                "linux",
                "windows"
              ]
            }
