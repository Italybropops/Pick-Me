                    "type": "null"
                  }
                ]
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "ease": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "interoperability": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "automation": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
