            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "setup": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "ease": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
