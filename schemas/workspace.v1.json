          "status",
          "installed",
          "setupConfirmed",
          "plan",
          "incrementalCost",
          "checkedAt",
          "provenance",
          "freshnessDays",
          "localVerified",
          "hardwareConfirmed",
          "licenseConfirmed",
          "automationVerified",
          "modelsReady",
          "allowance",
          "menus",
          "notes"
